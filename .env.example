# ---- deployment (docker compose) -------------------------------------------
# Public hostname Caddy requests a certificate for.  An A record must already
# point at this server, and ports 80/443 must be reachable from the internet for
# the ACME challenge.  Compose is invoked with `--env-file ../.env` so this line
# is what feeds `${AML_DOMAIN}` in deploy/Caddyfile.
AML_DOMAIN=memory.example.com
# Memory cap for the service container: 2g fits the cheapest 2 GB VPS, use 3g on
# a 4 GB box.  Keep it below total RAM so the kernel never has to choose a victim.
AML_MEMORY_LIMIT=2g

# ---- AML platform contract -------------------------------------------------
# Paths the evaluation platform will call. Keep them identical to the URLs you
# register on the leaderboard.  Sub-paths are fine (e.g. /aml/add).
AML_ADD_PATH=/add
AML_SEARCH_PATH=/search
AML_HEALTH_PATH=/health

# Bearer token the platform will present.  Leave empty only for public smoke runs.
AML_API_KEY=
# Set to 1 to accept unauthenticated calls (local experiments only).
AML_DISABLE_AUTH=0

# ---- storage ---------------------------------------------------------------
AML_DATA_DIR=./data

# ---- embeddings ------------------------------------------------------------
# Allowed by the rules: text-embedding-v4.  Providers:
#   openai (OpenAI-compatible, e.g. DashScope MaaS) | dashscope-native | local | hash
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024
EMBED_BASE_URL=https://ws-i35enzeci2mcdfzq.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_BATCH=10
EMBED_CONCURRENCY=6
EMBED_MAX_CHARS=6000

# ---- LLM (optional) --------------------------------------------------------
# The answer model is supplied by the platform; this LLM is only used for
# optional query planning and session summaries.  Must be gpt-4o-mini when used.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=60
AML_QUERY_LLM=0
AML_INGEST_LLM=off
# only used when AML_INGEST_LLM=on (needs a gpt-4o-mini endpoint)
AML_SESSION_SUMMARY_CHARS=1200

# ---- retriever -------------------------------------------------------------
AML_TOP_K_MAX=100
AML_CANDIDATE_DEPTH=500
AML_DENSE_WEIGHT=1.0
AML_BM25_WEIGHT=1.0
AML_RRF_K=20
AML_EXPAND_NEIGHBORS=1
AML_MERGE_MAX_UNITS=3
AML_MIN_ITEMS=8
AML_MAX_CONTENT_CHARS=700
AML_TOTAL_CHAR_BUDGET=320000
# Context widening.  The platform caps the NUMBER of items (100) but not the size
# of an item, and it truncates the answer prompt by keeping a PREFIX of our list,
# so a top hit is worth far more when it carries the turns around it.
#   0                     -> every item is exactly one turn (pre-widening behaviour)
#   radius 2, top 30      -> the 30 highest-ranked hits carry +/-2 same-session turns
#   fill 100              -> ranks 30..99 carry +/-1 turn, so the tail keeps recall
# Session boundaries are never crossed.  Measured on LoCoMo-Refined: R@1 .591 -> .748.
AML_CONTEXT_RADIUS=2
AML_CONTEXT_TOP=30
AML_CONTEXT_FILL=100
# >0 refills the list after widening has absorbed turns (a no-op on LoCoMo-Refined,
# where the reserve is already inside the widened blocks); 0 keeps the shorter list.
AML_CONTEXT_FILL_TO=100
# Items whose token sets overlap more than this are the same memory twice.
# Similarity is computed on the statement body (the "Speaker (date):" header is
# dropped first), so the same sentence said on two dates counts as a duplicate.
AML_DEDUPE_JACCARD=0.85
# Which half of a duplicate survives: "score" keeps the better-ranked one,
# "newer" keeps the most recent statement (update questions want the newer half).
AML_DEDUPE_PREFER=score
# A turn that explicitly retracts an earlier one ("forget that I…", "I no longer…")
# retires the older row so the reader is never handed both halves of a changed fact.
# Off by default: the match is lexical, and a wrong retirement is a silent answer loss.
AML_FORGET_MATCHING=0
# How much of the retraction's subject must appear in the candidate (containment).
AML_FORGET_THRESHOLD=0.45
# Counting and list questions are exhaustive by nature; this caps them.
AML_EXHAUSTIVE_CAP=40
# Exhaustive questions widen their own top hits; 1 = on.
AML_EXHAUSTIVE_WIDEN=1
# Multiplier on assistant-role turns at ranking time (1.0 = no prior).
AML_ASSISTANT_PRIOR=1.0
# Ranking tilt toward newer turns for "still ...? / what is X now" questions only.
# 0 = off (shipped).  0.25 measured +1.3 pp R@1 on LongMemEval knowledge-update.
AML_UPDATE_BOOST=0.0
# Always-on recency tilt.  0 = off (shipped): measured neutral on LoCoMo-Refined
# and clearly negative on LongMemEval (0.464 -> 0.432 at 0.05), so leave it alone.
AML_RECENCY_PRIOR=0.0
# Score floor relative to the best hit (0 keeps every candidate up to top_k; the
# tuned configuration wants the volume, so 0 is the shipped value).
AML_SCORE_FLOOR=0.0

# ---- concurrency / limits --------------------------------------------------
AML_MAX_CONCURRENT_INGEST=8
AML_MAX_CONCURRENT_SEARCH=16
# RAM guard for the per-user search indexes (100k turns at dim 1024 ~ 410 MB each).
# 120000 rows is ~470 MB of matrix: raise it only if the box has spare RAM.
AML_INDEX_CACHE_COUNT=24
AML_INDEX_CACHE_VECTORS=120000
# in-process embedding cache: float16, bounded by bytes as well as by entries
EMBED_CACHE_MB=256
EMBED_CACHE_SIZE=100000
EMBED_CACHE_ROWS=200000
# Cache ingested (document) texts too? Off: they are already in `vectors`, so
# caching them again doubles the disk cost of every turn.
EMBED_CACHE_DOCS=0
# Ceiling for one outbound embedding/rerank call (capped at 180 s / 60 s internally).
AML_REQUEST_TIMEOUT_S=1700
AML_LOG_PROMPTS=0
# Set to 1 to ignore ./.env (the test suite sets this so a developer's .env cannot
# leak into a test run; the container's environment always wins over the file).
AML_SKIP_DOTENV=0
# Optional: absolute path to the env file to load.  Lookup order is AML_ENV_FILE,
# then ./.env, then the .env beside the package — so `uvicorn` started from another
# directory still finds its configuration.  Empty means "search".
AML_ENV_FILE=

# ---- reranker (unrestricted by the rules) ----------------------------------
#   none | local (sentence-transformers CrossEncoder) | dashscope (gte-rerank-v2)
#   Measured: the hosted reranker is both faster and better than MiniLM locally.
RERANK_PROVIDER=dashscope
RERANK_MODEL=gte-rerank-v2
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
RERANK_DEPTH=60
RERANK_BATCH=16
# Past this budget a slow rerank is abandoned and the fused order is returned as-is,
# so one slow provider call cannot stall a search.
RERANK_TIMEOUT_S=12

